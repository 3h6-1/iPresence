#!/var/jb/bin/sh
# Original project by kainograze. Updated by 3h6_1.
set -eu
[ -z "${DPKG_ROOT:-}" ] || exit 0
case "${1:-}" in
    remove|upgrade|deconfigure)
        /bin/launchctl bootout system/com.kainograze.iPresence-Daemon 2>/dev/null || true
        if [ "${1:-}" = remove ]; then
            /var/jb/usr/bin/uicache -u /var/jb/Applications/iPresence.app
        fi
        ;;
esac
